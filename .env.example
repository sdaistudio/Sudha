# Copy to .env.local for local development (never commit real keys).
OPENAI_API_KEY=
# Optional: defaults to gpt-6.1-sol
OPENAI_MODEL=
# Optional, comma-separated: extra browser origins allowed to call /api/chat (e.g. the GitHub Pages site)
ALLOWED_ORIGINS=https://sdaistudio.github.io
# Frontend: where the site sends chat requests. Leave empty to use same-origin /api/chat (Vercel).
VITE_CHAT_API_URL=
